# Azure AD app registration (Microsoft Graph)
# Register at https://portal.azure.com -> App registrations -> New registration
# Redirect URI (public client / mobile & desktop): http://localhost:3000/redirect
# API permissions (delegated): Mail.Read, offline_access, User.Read
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/redirect

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app07Y0T2rtod3A9F
AIRTABLE_TABLE_NAME=Inbox Dates

# How many days back to scan the inbox on each run
LOOKBACK_DAYS=14

# Optional: restrict to a specific mail folder (defaults to Inbox)
MS_MAIL_FOLDER=inbox
